# Entorno virtual y cachés de Python
.venv/
__pycache__/
*.pyc

# Datos geospatiales pesados
*.tif
*.xyz
*.npy

# Todo lo que el flujo de revisión escribe en la carpeta desde donde corre la
# app. Esto NO es código: es caché y entregables, y se regeneran corriendo el
# análisis. datos/ e informes/ son caché que la app relee para no repetir
# trabajo; descargas/ son los archivos que uno se lleva.
datos/
informes/
analistas/
ploteo/
trabajo/
descargas/
listados/

# Catálogos bajados del servidor y derivados que quedan en la raíz del
# directorio de ejecución. Ojo: base_*.dat y base_*.csv SÍ son del proyecto y
# están versionados, así que acá van los nombres con prefijo propio y no *.dat.
select.out
select_*.out
eventquery_*.csv
*.csv.completo

# Excepción: las fixtures de los tests (casos del arnés) sí se versionan.
!tests/**/select.out

# Residuo de cuando el flujo escribía en la raíz; ahora todo va a datos/.
/eventos_eventquery.json
/conteo_perfiles_eventquery.json
/sospechosos_eventquery.csv

# Binario de PlantUML para los diagramas de docs/proyecto/ (pesado; se baja con
# docs/proyecto/herramientas/traer_plantuml.sh). Los .puml y los .png sí van.
docs/proyecto/herramientas/plantuml.jar